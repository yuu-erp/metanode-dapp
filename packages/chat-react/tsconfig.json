{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "module": "ES2020",
    "moduleResolution": "Bundler",
    "lib": ["ES2020", "DOM"],
    "paths": {
      "~/*": ["./src/*"]
    }
  },
  "include": ["src/**/*", "rollup.config.cjs"],
  "exclude": ["dist", "node_modules"]
}
